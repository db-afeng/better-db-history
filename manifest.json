{
  "manifest_version": 3,
  "name": "Better Databricks History",
  "version": "0.0.11",
  "description": "Enhances the Databricks UC table history tab with custom functionality",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.cloud.databricks.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.cloud.databricks.com/explore/data/*"],
      "js": ["chart.min.js", "chartjs-adapter-date-fns.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
