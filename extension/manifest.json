{
  "manifest_version": 3,
  "name": "Better Databricks History",
  "version": "0.1.1",
  "description": "Enhances the Databricks UC table history tab",
  "host_permissions": [
    "https://*.cloud.databricks.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.cloud.databricks.com/explore/data/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
